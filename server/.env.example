# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Frontend origin allowed to call this API (Vite dev server)
CLIENT_ORIGIN=http://localhost:3000

# Clerk (dashboard.clerk.com -> API Keys)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dodo Payments (test mode) - dashboard.dodopayments.com -> Developer -> API Keys
DODO_API_KEY=
DODO_ENVIRONMENT=test_mode
DODO_PRODUCT_ID=pdt_0NmvqOrB01KtIWKY0htQs
# Dodo dashboard -> Webhooks -> Add endpoint -> copy the signing secret shown there
DODO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Dodo should send the buyer back after checkout
CHECKOUT_RETURN_URL=http://localhost:3000/?checkout=complete

SQLITE_PATH=./data/landofsaas.db
